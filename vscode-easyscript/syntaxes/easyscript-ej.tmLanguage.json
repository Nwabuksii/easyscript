{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "easyScript",
  "scopeName": "source.easyscript",
  "patterns": [
    { "include": "#print-out" },
    { "include": "#function-declaration" },
    { "include": "#class-declaration" },
    { "include": "#keywords" },
    { "include": "#operator-keywords" },
    { "include": "source.js" }
  ],
  "repository": {
    "print-out": {
      "match": "\\b(print)\\s*(\\.)\\s*(out)\\b",
      "captures": {
        "1": { "name": "support.class.easyscript" },
        "2": { "name": "punctuation.accessor.easyscript" },
        "3": { "name": "entity.name.function.easyscript" }
      }
    },
    "function-declaration": {
      "begin": "\\b(block|setup)\\s*([A-Za-z_$][\\w$]*)?\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "storage.type.function.easyscript" },
        "2": { "name": "entity.name.function.easyscript" },
        "3": { "name": "punctuation.definition.parameters.begin.easyscript" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.easyscript" }
      },
      "patterns": [{ "include": "#parameter-list" }]
    },
    "parameter-list": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_$][\\w$]*)\\b\\s*(\\?)?\\s*(:)\\s*([A-Za-z_$][\\w$.<>\\[\\]|]*)",
          "captures": {
            "1": { "name": "variable.parameter.easyscript" },
            "2": { "name": "keyword.operator.optional.easyscript" },
            "3": { "name": "punctuation.separator.type.easyscript" },
            "4": { "name": "support.type.easyscript" }
          }
        },
        {
          "match": "\\b([A-Za-z_$][\\w$]*)\\b",
          "captures": {
            "1": { "name": "variable.parameter.easyscript" }
          }
        }
      ]
    },
    "class-declaration": {
      "match": "\\b(bprint|contract)\\s+([A-Za-z_$][\\w$]*)",
      "captures": {
        "1": { "name": "storage.type.class.easyscript" },
        "2": { "name": "entity.name.type.class.easyscript" }
      }
    },
    "keywords": {
      "patterns": [
        { "name": "storage.type.easyscript", "match": "\\b(fixed|make|mutable)\\b" },
        { "name": "keyword.control.easyscript", "match": "\\b(when|othen|ifnot|match|option|other|runtill|keeprun|exec|stop|skip|send|bring|give|pending|waitfor)\\b" },
        { "name": "storage.type.function.easyscript", "match": "\\b(block|bprint|contract|inherits|follows|setup|self)\\b" }
      ]
    },
    "operator-keywords": {
      "patterns": [
        {
          "match": "\\b(is|isnot|and|or)\\b",
          "name": "keyword.operator.word.easyscript"
        }
      ]
    }
  }
}