{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "easyScript",
  "scopeName": "source.easyscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template-strings" },
    { "include": "#regex" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.easyscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.easyscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.easyscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.easyscript", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.easyscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.easyscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "template-strings": {
      "patterns": [
        {
          "name": "string.template.easyscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "include": "#template-expression" },
            { "name": "constant.character.escape.easyscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "template-expression": {
      "begin": "\\$\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#constants" }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.easyscript",
          "begin": "(?<![\\w$)\\]])/(?![/*])",
          "end": "/[gimsuy]*",
          "patterns": [
            { "name": "constant.character.escape.easyscript", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.easyscript",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|(\\d[\\d_]*\\.?[\\d_]*|\\.\\d[\\d_]*)([eE][+-]?\\d+)?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.easyscript",
          "match": "\\b(fixed|make|mutable)\\b"
        },
        {
          "name": "keyword.control.easyscript",
          "match": "\\b(when|othen|ifnot|match|option|other|runtill|keeprun|exec|stop|skip|send|bring|give|pending|waitfor)\\b"
        },
        {
          "name": "storage.type.function.easyscript",
          "match": "\\b(block|bprint|contract)\\b"
        },
        {
          "name": "storage.modifier.easyscript",
          "match": "\\b(inherits|follows|setup|self)\\b"
        },
        {
          "name": "keyword.operator.word.easyscript",
          "match": "\\b(is|isnot|and|or)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.easyscript",
          "match": "(===|!==|=>|\\+\\+|--|\\+=|-=|\\*=|/=|&&|\\|\\||[+\\-*/%=<>!&|^~?])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.easyscript",
          "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b"
        },
        {
          "name": "variable.language.easyscript",
          "match": "\\b(self|this|super)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.easyscript",
          "match": "\\b([a-zA-Z_$][\\w$]*)\\s*(?=\\()"
        }
      ]
    }
  }
}